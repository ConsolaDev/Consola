*
!vercel.json
# vercel.json's ignoreCommand runs this script, which reads this file to learn what the site is
# built from, and skips a deployment when none of those files changed (a preview counts only the
# website's own).
!.vercelignore
!tools
!tools/vercel-ignore.mjs
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
# pnpm opens every patch pnpm-workspace.yaml names before it installs anything.
!patches
!patches/**
!apps
!apps/website
!apps/website/package.json
!apps/website/index.html
!apps/website/vite.config.mjs
!apps/website/tsconfig.json
!apps/website/src
!apps/website/src/**
!apps/website/demo
!apps/website/demo/**
!apps/website/download
!apps/website/download/**
!apps/website/public
!apps/website/public/**
!apps/desktop
!apps/desktop/package.json
!apps/desktop/tsconfig.renderer.json
!apps/desktop/src
!apps/desktop/src/renderer
!apps/desktop/src/renderer/**
!apps/desktop/src/shared
!apps/desktop/src/shared/**
