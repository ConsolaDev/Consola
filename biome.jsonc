{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/release",
      // Worktrees live here, each a full copy of the repo.
      "!.claude",
      "!.claude-tracker.json",
      "!.worktrees",
      // Captured GitHub API responses, kept byte for byte.
      "!apps/desktop/tests/fixtures/stub-gh",
      // Hand-minified, and parts of it do not parse.
      "!apps/website/src/styles.css",
      // Copied from t3code; kept byte for byte (vendor/t3code/UPSTREAM.md).
      "!vendor",
      // Copied from t3code; kept byte for byte (vendor/t3code/UPSTREAM.md).
      "!packages/agent-ui/src/t3",
      "!packages/agent-ui/src/gt.config.json",
      // The APIs' contracts and the web app's types, generated and compared byte for byte.
      "!apps/cloud-global/openapi.json",
      "!apps/cloud-region/openapi.json",
      "!apps/cloud-web/src/domain/apiContract.ts",
      "!apps/cloud-web/src/domain/cellApiContract.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    // Applies to TypeScript and TSX as well; Biome has no separate section.
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    // Sorting imports would reorder nearly every file, and in the main
    // process module order can carry side effects. Off until wanted.
    "actions": { "source": { "organizeImports": "off" } }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      // A rule that Oxlint (oxlint.config.mts) also runs, as the same rule
      // (Biome's own rule sources call it so) and as an error everywhere this
      // config lints, is off here, so each finding is reported once. Biome
      // keeps every rule Oxlint has no same rule for, those Oxlint leaves to
      // TypeScript in .ts files, and accessibility, which Oxlint leaves to it.
      "correctness": {
        "noConstantCondition": "off",
        "noEmptyCharacterClassInRegex": "off",
        "noEmptyPattern": "off",
        "noNonoctalDecimalEscape": "off",
        "noPrecisionLoss": "off",
        "noSelfAssign": "off",
        "noSwitchDeclarations": "off",
        "noUnsafeFinally": "off",
        "noUnsafeOptionalChaining": "off",
        "noUnusedImports": "off",
        "noUnusedLabels": "off",
        "noUnusedPrivateClassMembers": "off",
        "noUnusedVariables": "off",
        "noVoidElementsWithChildren": "off",
        "useIsNan": "off",
        "useValidForDirection": "off",
        "useValidTypeof": "off",
        "useYield": "off",
        // Each existing case needs its own judgment (adding a dependency can
        // loop an effect). Warn so the editor flags them while fixing.
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "off",
        "noCatchAssign": "off",
        "noCommentText": "off",
        "noCompareNegZero": "off",
        "noDebugger": "off",
        "noDoubleEquals": "off",
        "noDuplicateCase": "off",
        "noDuplicateElseIf": "off",
        "noDuplicateJsxProps": "off",
        "noExplicitAny": "off",
        "noExtraNonNullAssertion": "off",
        "noFallthroughSwitchClause": "off",
        "noGlobalAssign": "off",
        "noIrregularWhitespace": "off",
        "noMisleadingCharacterClass": "off",
        "noMisleadingInstantiator": "off",
        "noSelfCompare": "off",
        "noShadowRestrictedNames": "off",
        "noSparseArray": "off",
        "noTsIgnore": "off",
        "noUnsafeDeclarationMerging": "off",
        "useNamespaceKeyword": "off",
        "noArrayIndexKey": "warn",
        // Terminal code matches escape and control characters on purpose.
        "noControlCharactersInRegex": "off",
        // Shell commands are written as strings, `${VAR}` included.
        "noTemplateCurlyInString": "off",
        // `string | void` lets a callback with no return satisfy the type.
        "noConfusingVoidType": "off",
        // Its fix, Object.hasOwn, needs the ES2022 lib; the code already uses
        // the safe Object.prototype.hasOwnProperty.call form.
        "noPrototypeBuiltins": "off",
        // Only hit was a semicolon that belongs to the sentence.
        "noSuspiciousSemicolonInJsx": "off",
        "useIterableCallbackReturn": {
          "level": "error",
          "options": { "checkForEach": false }
        }
      },
      "style": {
        "useArrayLiterals": "off",
        "useConst": "off",
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off",
        // Its fix turns `lines.join('\n') + '\n'` into a nested template.
        "useTemplate": "off"
      },
      "complexity": {
        "noExtraBooleanCast": "off",
        "noUselessCatch": "off",
        "noUselessEscapeInRegex": "off",
        "noUselessRename": "off",
        "noUselessTypeConstraint": "off",
        "useFlatMap": "off",
        // Used to override third-party styles (syntax highlighting, xterm)
        // and to stop motion under prefers-reduced-motion.
        "noImportantStyles": "off"
      },
      "security": {
        "noBlankTarget": "off",
        "noGlobalEval": "off"
      },
      "a11y": {
        // A desktop app focusing the field a dialog opened for.
        "noAutofocus": "off",
        // Every button says its type: an error, as Oxlint no longer checks it.
        "useButtonType": "error",
        // Existing cases need per-component review. Warn until cleared.
        "useSemanticElements": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noNoninteractiveTabindex": "warn",
        "useFocusableInteractive": "warn",
        "noSvgWithoutTitle": "warn",
        "useValidAnchor": "warn",
        "noLabelWithoutControl": "warn",
        "useValidAriaValues": "warn"
      },
      "nursery": {
        // Oxlint's typescript/no-floating-promises and no-misused-promises
        // read TypeScript's own types. Biome's guess them: its
        // noMisusedPromises read a Map.get result as always present, so every
        // `if (pending) return pending` was a false alarm.
        "noFloatingPromises": "off"
      }
    }
  },
  "css": {
    "linter": { "enabled": true }
  },
  // Code only: prose and workflow files keep the style they were written in.
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "overrides": [
    {
      // Component stylesheets are ordered by component, not by specificity.
      "includes": ["**/*.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    }
  ]
}
