#!/usr/bin/env bash
# Canned `gh` for tests. Keyed on argv so every consumer — GitHubDriver
# probes and fetches, WorktreeService checkouts, the clone flow, and the
# Playwright inbox spec — runs deterministically without network or a keyring.
#
# Env knobs:
#   STUB_GH_FAIL=1                every invocation exits 1 with a canned stderr line
#   STUB_GH_CLONE_FROM=path       `repo clone` clones from this local repo instead of GitHub
#   STUB_GH_LOG=path              append one line per invocation: argv (newlines
#                                 flattened — the GraphQL query spans lines) then
#                                 the GH_TOKEN the call saw
#   GRAPHQL_INBOX_FIXTURE=path    `api graphql` prints this file instead of graphql-inbox.json
#   STUB_GH_PULLS=path            `api repos/...` (endpoint first) answers from this file:
#                                 one `<endpoint> <json>` pair per line; an endpoint
#                                 with no line is a 404, as GitHub would answer
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${STUB_GH_LOG:-}" ]]; then
  # printf '%s' rather than echo so the only newline is the one added after
  # flattening; a trailing space would otherwise ride into every assertion.
  # One write per call: concurrent callers (batched PR lookups) would
  # otherwise interleave a line and its newline.
  line="$(printf '%s' "$* GH_TOKEN=${GH_TOKEN:-}" | tr '\n' ' ')"
  printf '%s\n' "$line" >> "$STUB_GH_LOG"
fi

if [[ "${STUB_GH_FAIL:-}" == "1" ]]; then
  echo "gh: canned failure (STUB_GH_FAIL=1)" >&2
  exit 1
fi

cmd="${1:-} ${2:-}"
case "$cmd" in
  "--version "*|"--version")
    echo "gh version 2.62.0 (stub)"
    ;;
  "auth status")
    echo "github.com"
    echo "  Logged in to github.com account JaviDev (keyring)"
    echo "  - Active account: true"
    ;;
  "auth token")
    # gh auth token --user <login>  ->  $3=--user  $4=<login>
    echo "gho_stub_token_for_${4:-unknown}"
    ;;
  "api graphql")
    # The static fixture keeps fixed dates for the parser tests; the e2e
    # points this at a payload it generates with live timestamps.
    cat "${GRAPHQL_INBOX_FIXTURE:-$here/graphql-inbox.json}"
    ;;
  "api repos/"*)
    # REST lookups (pull request state): gh api <endpoint> --hostname github.com
    if [[ -n "${STUB_GH_PULLS:-}" && -f "$STUB_GH_PULLS" ]]; then
      while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "${line%% *}" == "$2" ]]; then
          printf '%s\n' "${line#* }"
          exit 0
        fi
      done < "$STUB_GH_PULLS"
    fi
    echo "gh: Not Found (HTTP 404)" >&2
    exit 1
    ;;
  "pr checkout")
    # Runs with the fresh worktree as cwd; simulate by switching to a PR branch.
    git checkout -B "stub-pr-${3:?pr number}" --quiet
    ;;
  "repo clone")
    # gh repo clone <owner/name> <dir> — clone from the local fixture instead.
    git clone --quiet "${STUB_GH_CLONE_FROM:?set STUB_GH_CLONE_FROM}" "${4:?target dir}"
    ;;
  *)
    echo "stub gh: unhandled argv: $*" >&2
    exit 64
    ;;
esac
