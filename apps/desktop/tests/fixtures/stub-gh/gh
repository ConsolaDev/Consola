#!/usr/bin/env bash
# Canned `gh` for tests. Keyed on argv so every consumer — GitHubDriver
# probes and fetches, WorktreeService checkouts, the clone flow, and the
# Playwright inbox spec — runs deterministically without network or a keyring.
#
# Env knobs:
#   STUB_GH_FAIL=1                every invocation exits 1 with a canned stderr line
#   STUB_GH_CLONE_FROM=path       `repo clone` clones from this local repo instead of GitHub
#   STUB_GH_LOG=path              append one line per invocation: argv (newlines
#                                 flattened — the GraphQL query spans lines) then
#                                 the GH_TOKEN the call saw
#   GRAPHQL_INBOX_FIXTURE=path    `api graphql` prints this file instead of graphql-inbox.json
#   STUB_GH_PULLS=path            `api repos/...` (endpoint first) answers from this file:
#                                 one `<endpoint> <json>` pair per line; an endpoint
#                                 with no line is a 404, as GitHub would answer
#   STUB_GH_DETAILS_DIR=path      an item's details answer from this directory instead of
#                                 ./details: one `<Operation>.json` per named GraphQL
#                                 operation (`query ConsolaPullRequest(...)`), and
#                                 pulls-files.json for the changed files
#   STUB_GH_STATE_DIR=path        a pending review exists while `pending-review` is in here:
#                                 starting a review creates it, submitting or discarding
#                                 removes it, and reads prefer `<Operation>.pending.json`
#   STUB_GH_OWNER_REPO / _NUMBER  which item an id is said to belong to (sprocket/catalog-portal#51)
#   STUB_GH_MUTATION_FAILURE_FILE while this file exists, every write is rejected
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${STUB_GH_LOG:-}" ]]; then
  # printf '%s' rather than echo so the only newline is the one added after
  # flattening; a trailing space would otherwise ride into every assertion.
  # One write per call: concurrent callers (batched PR lookups) would
  # otherwise interleave a line and its newline.
  line="$(printf '%s' "$* GH_TOKEN=${GH_TOKEN:-}" | tr '\n' ' ')"
  printf '%s\n' "$line" >> "$STUB_GH_LOG"
fi

if [[ "${STUB_GH_FAIL:-}" == "1" ]]; then
  echo "gh: canned failure (STUB_GH_FAIL=1)" >&2
  exit 1
fi

details_dir="${STUB_GH_DETAILS_DIR:-$here/details}"

reject_writes() {
  if [[ -n "${STUB_GH_MUTATION_FAILURE_FILE:-}" && -f "$STUB_GH_MUTATION_FAILURE_FILE" ]]; then
    echo 'GitHub rejected this action: repository rules are not satisfied.' >&2
    exit 1
  fi
}

# Which item each id handed to ConsolaNodeOwners belongs to, its type read
# from GitHub's id prefixes (PRRT_ thread, PRRC_ review comment, PRR_ review,
# IC_ issue comment).
node_owners() {
  local out='{"data":{' sep='' arg key id type where
  local repo="${STUB_GH_OWNER_REPO:-sprocket/catalog-portal}" number="${STUB_GH_OWNER_NUMBER:-51}"
  for arg in "$@"; do
    [[ "$arg" =~ ^n[0-9]+= ]] || continue
    key="${arg%%=*}"; id="${arg#*=}"
    case "$id" in
      PRRT_*) type=PullRequestReviewThread ;;
      PRRC_*) type=PullRequestReviewComment ;;
      PRR_*) type=PullRequestReview ;;
      IC_*) type=IssueComment ;;
      *) out+="$sep\"$key\":null"; sep=','; continue ;;
    esac
    if [[ "$type" == IssueComment ]]; then
      where="\"issue\":{\"number\":$number},\"repository\":{\"nameWithOwner\":\"$repo\"}"
    else
      where="\"pullRequest\":{\"number\":$number,\"repository\":{\"nameWithOwner\":\"$repo\"}}"
    fi
    out+="$sep\"$key\":{\"__typename\":\"$type\",$where}"; sep=','
  done
  printf '%s}}\n' "$out"
}

# A named Consola operation: details reads and writes. Prints nothing and
# returns 1 for anything else (the Inbox's own anonymous query).
details_graphql() {
  local arg query='' op
  for arg in "$@"; do
    [[ "$arg" == query=* ]] && query="${arg#query=}"
  done
  op="$(printf '%s\n' "$query" | sed -nE '1s/^(query|mutation) (Consola[A-Za-z]+).*/\2/p')"
  [[ -n "$op" ]] || return 1
  if [[ "$query" == mutation* ]]; then
    reject_writes
    if [[ -n "${STUB_GH_STATE_DIR:-}" ]]; then
      case "$op" in
        ConsolaStartReview) touch "$STUB_GH_STATE_DIR/pending-review" ;;
        ConsolaSubmitReview|ConsolaDiscardReview) rm -f "$STUB_GH_STATE_DIR/pending-review" ;;
      esac
    fi
    if [[ -f "$details_dir/$op.json" ]]; then cat "$details_dir/$op.json"; else echo '{"data":{}}'; fi
    return 0
  fi
  if [[ "$op" == ConsolaNodeOwners ]]; then
    node_owners "$@"
    return 0
  fi
  local file="$details_dir/$op.json"
  if [[ -n "${STUB_GH_STATE_DIR:-}" && -f "$STUB_GH_STATE_DIR/pending-review" && -f "$details_dir/$op.pending.json" ]]; then
    file="$details_dir/$op.pending.json"
  fi
  if [[ ! -f "$file" ]]; then
    echo "stub gh: no fixture for $op" >&2
    exit 64
  fi
  cat "$file"
}

cmd="${1:-} ${2:-}"
case "$cmd" in
  "--version "*|"--version")
    echo "gh version 2.62.0 (stub)"
    ;;
  "auth status")
    echo "github.com"
    echo "  Logged in to github.com account JaviDev (keyring)"
    echo "  - Active account: true"
    ;;
  "auth token")
    # gh auth token --user <login>  ->  $3=--user  $4=<login>
    echo "gho_stub_token_for_${4:-unknown}"
    ;;
  "api graphql")
    details_graphql "$@" && exit 0
    # The static fixture keeps fixed dates for the parser tests; the e2e
    # points this at a payload it generates with live timestamps.
    cat "${GRAPHQL_INBOX_FIXTURE:-$here/graphql-inbox.json}"
    ;;
  "api repos/"*)
    # REST lookups (pull request state): gh api <endpoint> --hostname github.com
    if [[ -n "${STUB_GH_PULLS:-}" && -f "$STUB_GH_PULLS" ]]; then
      while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "${line%% *}" == "$2" ]]; then
          printf '%s\n' "${line#* }"
          exit 0
        fi
      done < "$STUB_GH_PULLS"
    fi
    echo "gh: Not Found (HTTP 404)" >&2
    exit 1
    ;;
  "pr view"|"issue view")
    cat "$here/item-details.json"
    ;;
  "api --hostname")
    # gh api --hostname github.com <endpoint> [--method POST -f ...]
    case "${4:-}" in
      graphql)
        details_graphql "$@" && exit 0
        echo 'stub gh: unhandled GraphQL operation' >&2; exit 64 ;;
      */pulls/*/comments)
        [[ " $* " == *" --method POST "* ]] || { echo 'stub gh: unhandled API endpoint' >&2; exit 64; }
        reject_writes
        echo '{"id":99}' ;;
      */pulls/*/files*) cat "$details_dir/pulls-files.json" ;;
      *) echo 'stub gh: unhandled API endpoint' >&2; exit 64 ;;
    esac
    ;;
  "pr comment"|"issue comment"|"pr review"|"pr close"|"issue close"|"pr reopen"|"issue reopen"|"pr ready"|"pr merge"|"pr edit"|"issue edit"|"pr update-branch")
    reject_writes
    echo 'Action completed.'
    ;;
  "pr checkout")
    # Runs with the fresh worktree as cwd; simulate by switching to a PR branch.
    git checkout -B "stub-pr-${3:?pr number}" --quiet
    ;;
  "repo clone")
    # gh repo clone <owner/name> <dir> — clone from the local fixture instead.
    git clone --quiet "${STUB_GH_CLONE_FROM:?set STUB_GH_CLONE_FROM}" "${4:?target dir}"
    ;;
  *)
    echo "stub gh: unhandled argv: $*" >&2
    exit 64
    ;;
esac
