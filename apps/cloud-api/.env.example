# Copy to .env and fill in. Nothing here is a real credential.

# ── REQUIRED ─────────────────────────────────────────────────────────────────────────────────
# The API does not start until each of these is set.

# Where the data lives: one database for the whole app. PGlite (Postgres in-process) keeps it in
# a local folder.
DATABASE_URL=pglite:./.data/cloud-db
# A real Postgres instead:
# DATABASE_URL=postgres://consola:consola@localhost:5432/consola_cloud

# Signs sessions. At least 32 characters. Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address people open in the browser (the web app), with no path.
PUBLIC_URL=http://localhost:5175

# Google OAuth client (Google Cloud console → APIs & Services → Credentials → OAuth client ID,
# type "Web application"). Its authorised redirect URI is <PUBLIC_URL>/api/auth/callback/google,
# so http://localhost:5175/api/auth/callback/google with the PUBLIC_URL above.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret


# ── OPTIONAL ─────────────────────────────────────────────────────────────────────────────────

# The port the API listens on, 3100 when unset. The web app's dev proxy (apps/cloud-web/
# vite.config.ts), the runner (ws://127.0.0.1:3100/api/runner) and the webhook tunnel all expect
# 3100: change them too if you change this.
# PORT=3100

# The deployment's region, eu or us: every new workspace is made in it. eu when unset.
# REGION=eu

# ── Consola's GitHub App ──
# Set all four, or none (then nothing can be connected to GitHub). The README's "Connect GitHub"
# says how to register the app (GitHub → Developer settings → GitHub Apps):
#   callback URL <PUBLIC_URL>/api/github/callback, with "Request user authorization (OAuth)
#   during installation" on; webhook URL the tunnel's address plus /api/github/webhooks.
# The client ID and slug are on the app's General page. The app's numeric ID is not needed: the
# client ID names the app in its tokens, as GitHub recommends.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The name in the app's public address, github.com/apps/<slug>.
GITHUB_APP_SLUG=
# The path of the private key GitHub downloads as a .pem. Keep the file outside the repository:
# .gitignore covers .env files, not keys.
GITHUB_APP_PRIVATE_KEY_PATH=

# The app's webhook secret, the same value as in the app's Webhook settings. GitHub signs every
# delivery with it, and the API refuses one it did not sign; with none, every delivery is refused.
# At least 32 characters. Make one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# A named Cloudflare tunnel for the webhooks, whose address stays put, instead of a quick tunnel
# with a new address each time. Read only by `pnpm --filter @consola/cloud-api webhooks:tunnel`
# (the README's "Receive GitHub's webhooks"): the tunnel's name, and the hostname routed to it.
# CLOUDFLARE_TUNNEL_NAME=
# CLOUDFLARE_TUNNEL_HOSTNAME=webhooks.example.com

# ── Connections' secrets (Slack) ──
# The key the API seals the secrets it keeps for its connections with (AES-256-GCM): a factory's
# Slack app's client secret, signing secret and bot token. 32 random bytes in base64. Make one
# with:
#   pnpm --filter @consola/cloud-api secrets-key:generate
# With none, Slack is off: its routes answer 503 slack_not_configured. A secret opens only with
# the key that sealed it, so changing the key means setting each factory's Slack app up again.
# CONNECTION_SECRETS_KEY=

# Where Slack reaches the API: each factory's manifest names it, for Slack's events
# (/api/slack/events/<factory id>) and its redirect after "Add to Slack"
# (/api/slack/oauth/callback). In development, the webhook tunnel's address (the README's
# "Connect a factory to Slack"). PUBLIC_URL when unset.
# SLACK_PUBLIC_URL=https://<tunnel address>

# ── RUNNER: cloud sessions ──
# Set all three, or none. With none, no runner can connect and starting a cloud session answers
# "No runner is connected for this workspace."; with only some, the API refuses to start.

# The secret the runner presents to open its socket (GET /api/runner, Authorization: Bearer ...):
# at least 32 printable characters with no spaces. Make one with: openssl rand -base64 32
# MUST MATCH CONSOLA_RUNNER_SECRET in packages/host/.env.
# RUNNER_SECRET=

# The one workspace the runner serves, by its id. Find it signed in, at
# http://localhost:5175/api/workspaces (each workspace's "id").
# RUNNER_WORKSPACE_ID=

# The key the API signs session passes with: an Ed25519 private key, as a JSON Web Key on one
# line. Make one with:
#   pnpm --filter @consola/cloud-api pass-key:generate
# and paste the line it prints after the `=`. Nothing else needs it: the API hands each session's
# sandbox the public half itself.
# PASS_PRIVATE_KEY=

# ── SESSION HOSTS: where the API may call a session's host itself ──
# The API sends a running agent run a person's follow-up straight to the session's host, at the
# address its runner reported. It calls only an address under one of these host names, over https
# on the default port, never an IP address. A comma list; e2b.app (E2B's exposed ports,
# https://<port>-<sandbox>.e2b.app) when unset.
# SANDBOX_HOST_SUFFIXES=e2b.app

# true when the runner's sandboxes run on this machine (tests, a local provider), so a host at
# http://127.0.0.1, http://localhost or http://[::1] may be called too. false when unset.
# LOCAL_SANDBOXES=false
