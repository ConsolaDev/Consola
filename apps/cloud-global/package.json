{
  "name": "@consola/cloud-global",
  "version": "0.0.0",
  "private": true,
  "description": "Consola Cloud's global API: Google sign-in, sessions and workspaces.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "openapi:generate": "vitest run src/adapters/http/openapi.test.ts --update",
    "auth:generate": "pnpm dlx auth@1.7.27 generate --config src/adapters/auth/cli-config.ts --output src/adapters/persistence/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "cell-key:generate": "node scripts/generate-cell-key.mjs",
    "webhooks:tunnel": "node scripts/webhook-tunnel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.27",
    "@consola/cloud-contract": "workspace:*",
    "@electric-sql/pglite": "^0.5.17",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "better-auth": "1.7.27",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "jose": "^6.2.10",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
