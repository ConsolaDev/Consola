# Copy to .env and fill in. Nothing here is a real credential.

# Where the data lives. PGlite (Postgres in-process) keeps it in a local folder.
DATABASE_URL=pglite:./.data/cloud-db
# A real Postgres instead (the compose file's database):
# DATABASE_URL=postgres://consola:consola@localhost:5432/consola_cloud

# Signs sessions. At least 32 characters, and left empty here so the API will not start until
# you set your own. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address people open in the browser (the web app), with no path.
PUBLIC_URL=http://localhost:5175

# The port the API listens on. Optional, defaults to 3100. `pnpm dev:cloud`'s web proxy targets
# 3100, so change apps/cloud-web/vite.config.ts too if you change this.
# PORT=3100

# Google OAuth client. Its redirect URI is <PUBLIC_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Signs the token a regional cell trusts: an Ed25519 private key, as a JSON Web Key on one line.
# Required, and left empty here so the API will not start until you set your own. Make one with:
#   pnpm --filter @consola/cloud-global cell-key:generate
# and paste the line it prints after the `=`. Keep it here only: anyone who has it can mint tokens
# every cell trusts. The cells need only its public key, which the API publishes at
# /api/cell-token/keys.
CELL_TOKEN_PRIVATE_KEY=

# The EU cell (pnpm dev:cloud-region) the outbox delivers to; CELL_URL_US names the US one.
CELL_URL_EU=http://127.0.0.1:3101

# Consola's GitHub App (GitHub → Developer settings → GitHub Apps). Its callback URL is
# <PUBLIC_URL>/api/github/callback, with "Request user authorization (OAuth) during installation"
# on, and its webhook URL is the Cloudflare tunnel's address plus /api/github/webhooks (the
# README's "Receive GitHub's webhooks"). The client
# ID and slug are on the app's General page. Optional: set the client ID, client secret, slug and
# private key path together, or leave all four empty and nothing can be connected to GitHub. The
# README's "Connect GitHub" says how to register the app.
# The app ID is not read: the client ID names the app in its tokens, as GitHub recommends.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The name in the app's public address, github.com/apps/<slug>.
GITHUB_APP_SLUG=
# The private key GitHub downloads as a .pem. Keep it outside the repository: .gitignore covers
# .env files, not keys.
GITHUB_APP_PRIVATE_KEY_PATH=
# The app's webhook secret, the same value as in its Webhook settings. GitHub signs every
# delivery with it, and the API refuses one it did not sign. Optional: without it, every webhook
# delivery is refused. At least 32 characters; generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# A named Cloudflare tunnel for the webhooks, whose address stays put, instead of a quick tunnel
# with a new address each time. Optional, and read only by
# `pnpm --filter @consola/cloud-global webhooks:tunnel`: the tunnel's name, and the hostname
# routed to it (webhooks.example.com).
# CLOUDFLARE_TUNNEL_NAME=
# CLOUDFLARE_TUNNEL_HOSTNAME=
