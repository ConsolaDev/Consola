# cloud-global: the API (accounts, sign-in, workspaces), on port 3100.
#
# Where: copy this file to apps/cloud-global/.env (cp .env.example .env, in this folder).
# Read by: `pnpm dev:cloud` and `pnpm --filter @consola/cloud-global …` (src/main.ts loads it),
# and the webhook tunnel script. Nothing here is a real credential; never commit your .env.
#
# What you need for what:
#   Sign in and make workspaces ............. REQUIRED below
#   Reach the EU cell (runs, cloud sessions)  CELL_URL_EU
#   Connect GitHub .......................... the GitHub App block
#   GitHub's webhooks ....................... GITHUB_WEBHOOK_SECRET (+ the tunnel, optional)
#   A cell asking for GitHub tokens ......... CELL_PUBLIC_KEY_EU
#
# The other files, for a cloud session on this Mac (packages/host/AGENTS.md, "Local cloud
# session demo", says the whole order):
#   apps/cloud-region/.env.example   the EU cell (port 3101)
#   packages/host/.env.example       the runner that starts sessions in E2B sandboxes
#   packages/sandbox/.env.example    Consola's E2B key, for building the sandbox template
# The web app (apps/cloud-web) has no .env: it reaches the API on 3100 and the EU cell at
# CELL_URL_EU from your shell, http://127.0.0.1:3101 when unset.


# ── REQUIRED ─────────────────────────────────────────────────────────────────────────────────
# The API does not start until each of these is set.

# Where the data lives. PGlite (Postgres in-process) keeps it in a local folder.
DATABASE_URL=pglite:./.data/cloud-db
# A real Postgres instead (the compose file's database):
# DATABASE_URL=postgres://consola:consola@localhost:5432/consola_cloud

# Signs sessions. At least 32 characters. Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address people open in the browser (the web app), with no path.
PUBLIC_URL=http://localhost:5175

# Google OAuth client (Google Cloud console → APIs & Services → Credentials → OAuth client ID,
# type "Web application"). Its authorised redirect URI is <PUBLIC_URL>/api/auth/callback/google,
# so http://localhost:5175/api/auth/callback/google with the PUBLIC_URL above.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Signs the token a regional cell trusts: an Ed25519 private key, as a JSON Web Key on one line.
# Make one with:
#   pnpm --filter @consola/cloud-global cell-key:generate
# and paste the line it prints after the `=`. Keep it only here: anyone who has it can mint tokens
# every cell trusts. The cells fetch its public half from /api/cell-token/keys; they never need
# this value.
CELL_TOKEN_PRIVATE_KEY=


# ── OPTIONAL ─────────────────────────────────────────────────────────────────────────────────

# The port the API listens on, 3100 when unset. The web app's dev proxy (apps/cloud-web/
# vite.config.ts) and the cell's CLOUD_GLOBAL_URL both expect 3100: change them too if you
# change this.
# PORT=3100

# ── The regional cells ──
# Where the outbox delivers each region's workspaces and members. A region with none keeps its
# messages until one is set, so a workspace there cannot use its cell (no runs, no cloud
# sessions). MUST MATCH the cell's own address: apps/cloud-region/.env's PORT (3101 when unset).
CELL_URL_EU=http://127.0.0.1:3101
# A second, US cell (apps/cloud-region/README.md, "Two cells on one machine"):
# CELL_URL_US=http://127.0.0.1:3102

# The public key a cell signs its requests for GitHub tokens with: an Ed25519 public key, as a
# JSON Web Key on one line ({"kty":"OKP","crv":"Ed25519","x":"..."}), never with its private part
# `d`, which only the cell holds. A region with none can ask for no GitHub token. The README's
# "GitHub tokens for a cell" says how to make the pair. The API refuses a private key here, one key
# for two cells, or CELL_TOKEN_PRIVATE_KEY's public half.
CELL_PUBLIC_KEY_EU=
# CELL_PUBLIC_KEY_US=

# ── Consola's GitHub App ──
# Set all four, or none (then nothing can be connected to GitHub). The README's "Connect GitHub"
# says how to register the app (GitHub → Developer settings → GitHub Apps):
#   callback URL <PUBLIC_URL>/api/github/callback, with "Request user authorization (OAuth)
#   during installation" on; webhook URL the tunnel's address plus /api/github/webhooks.
# The client ID and slug are on the app's General page. The app's numeric ID is not needed: the
# client ID names the app in its tokens, as GitHub recommends.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The name in the app's public address, github.com/apps/<slug>.
GITHUB_APP_SLUG=
# The path of the private key GitHub downloads as a .pem. Keep the file outside the repository:
# .gitignore covers .env files, not keys.
GITHUB_APP_PRIVATE_KEY_PATH=

# The app's webhook secret, the same value as in the app's Webhook settings. GitHub signs every
# delivery with it, and the API refuses one it did not sign; with none, every delivery is refused.
# At least 32 characters. Make one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# A named Cloudflare tunnel for the webhooks, whose address stays put, instead of a quick tunnel
# with a new address each time. Read only by `pnpm --filter @consola/cloud-global webhooks:tunnel`
# (the README's "Receive GitHub's webhooks"): the tunnel's name, and the hostname routed to it.
# CLOUDFLARE_TUNNEL_NAME=
# CLOUDFLARE_TUNNEL_HOSTNAME=webhooks.example.com
