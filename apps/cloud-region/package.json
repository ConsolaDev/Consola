{
  "name": "@consola/cloud-region",
  "version": "0.0.0",
  "private": true,
  "description": "Consola Cloud's regional cell: what a workspace holds in its region, one copy per region.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "vitest run src/adapters/http/openapi.test.ts --update",
    "pass-key:generate": "node scripts/generate-pass-key.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@consola/cloud-contract": "workspace:*",
    "@consola/factory-spec": "workspace:*",
    "@consola/runner-protocol": "workspace:*",
    "@electric-sql/pglite": "^0.5.17",
    "@hono/node-server": "^2.1.11",
    "@hono/node-ws": "^1.3.2",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "jose": "^6.2.10",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "ws": "^8.23.0"
  }
}
