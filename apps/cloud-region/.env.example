# Copy to .env and fill in. Nothing here is a real credential.

# Where the cell's data lives. PGlite (Postgres in-process) keeps it in a local folder. A second
# cell on the same machine needs a folder of its own.
DATABASE_URL=pglite:./.data/cell-eu-db
# A real Postgres instead: a database of its own, never cloud-global's (see README.md).
# DATABASE_URL=postgres://consola:consola@localhost:5432/consola_cell_eu

# The region this cell serves: eu or us. Each region runs a copy of the cell of its own.
REGION=eu

# The port the cell listens on. Optional, defaults to 3101. A second cell on the same machine
# needs another, say 3102.
# PORT=3101
