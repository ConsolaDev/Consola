# Copy to .env and fill in. Nothing here is a real credential.

# ── The cell ─────────────────────────────────────────────────────────────────────────────────

# Where the cell's data lives. PGlite (Postgres in-process) keeps it in a local folder. A second
# cell on the same machine needs a folder of its own.
DATABASE_URL=pglite:./.data/cell-eu-db
# A real Postgres instead: a database of its own, never cloud-global's (see README.md).
# DATABASE_URL=postgres://consola:consola@localhost:5432/consola_cell_eu

# The region this cell serves: eu or us. Each region runs a copy of the cell of its own, and a
# workspace uses the cell of the region it was made in.
REGION=eu

# The port the cell listens on, 3101 when unset. A second cell on the same machine needs another,
# say 3102. MUST MATCH cloud-global's CELL_URL_EU (apps/cloud-global/.env) and the web app's
# CELL_URL_EU (your shell; http://127.0.0.1:3101 when unset).
# PORT=3101

# cloud-global's address, with no path. The cell fetches the public keys that sign its tokens
# from <CLOUD_GLOBAL_URL>/api/cell-token/keys and trusts no others. http://127.0.0.1:3100 when
# unset, which is cloud-global's own default PORT. Plain http only on this machine; https anywhere
# else.
# CLOUD_GLOBAL_URL=http://127.0.0.1:3100


# ── RUNNER: cloud sessions ───────────────────────────────────────────────────────────────────
# Set all three, or none. With none, no runner can connect and starting a cloud session answers
# "No runner is connected for this workspace."; with only some, the cell refuses to start.

# The secret the runner presents to open its socket (GET /api/runner, Authorization: Bearer ...):
# at least 32 printable characters with no spaces. Make one with: openssl rand -base64 32
# MUST MATCH CONSOLA_RUNNER_SECRET in packages/host/.env.
# RUNNER_SECRET=

# The one workspace the runner serves, by its id in cloud-global. Find it signed in, at
# http://localhost:5175/api/workspaces (each workspace's "id"; pick one whose region is this
# cell's REGION).
# RUNNER_WORKSPACE_ID=

# The key the cell signs session passes with: an Ed25519 private key, as a JSON Web Key on one
# line. It is the cell's own, never cloud-global's CELL_TOKEN_PRIVATE_KEY. Make one with:
#   pnpm --filter @consola/cloud-region pass-key:generate
# and paste the line it prints after the `=`. Nothing else needs it: the cell hands each session's
# sandbox the public half itself.
# PASS_PRIVATE_KEY=


# ── RUNNER: automations ──────────────────────────────────────────────────────────────────────
# Optional. The key the cell signs its requests to cloud-global for a run's GitHub tokens with: an
# Ed25519 private key, as a JSON Web Key on one line. It is the cell's own, never PASS_PRIVATE_KEY
# nor cloud-global's CELL_TOKEN_PRIVATE_KEY. Make one with:
#   pnpm --filter @consola/cloud-region cell-key:generate
# and paste the first line it prints after the `=`. MUST MATCH the public half it prints after,
# which goes in cloud-global's .env as CELL_PUBLIC_KEY_EU (or CELL_PUBLIC_KEY_US, for a us cell).
# Unset, the cell gives a run no GitHub token, and says why.
# CELL_PRIVATE_KEY=
