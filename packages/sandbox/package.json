{
  "name": "@consola/sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "One interface for starting and driving sandboxes, whichever provider runs them, with the contract every provider passes and an in-memory fake for tests.",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./e2b": {
      "types": "./dist/e2b.d.ts",
      "default": "./dist/e2b.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "e2b": "2.64.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3",
    "vitest": "^4.1.12"
  }
}
