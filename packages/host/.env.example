# Copy to .env and fill in. Nothing here is a real credential.

# ── REQUIRED ─────────────────────────────────────────────────────────────────────────────────

# The secret the runner opens its socket to the cloud app with (--cell-url, in development
# ws://127.0.0.1:3100/api/runner). MUST MATCH RUNNER_SECRET in apps/cloud-api/.env.
CONSOLA_RUNNER_SECRET=

# The repositories this runner offers, as owner/name, comma-separated: the web app's New session
# lists exactly these. Each sandbox clones its session's one from github.com.
CONSOLA_RUNNER_REPOSITORIES=your-org/your-test-repo

# The key of Consola's E2B account (e2b.dev → Dashboard → API Keys), where the consola-session
# template is built (packages/host/sandbox-template/README.md records its id). The same value as
# packages/sandbox/.env's E2B_API_KEY, which builds that template. Every session starts a real
# sandbox on this account.
E2B_API_KEY=

# ── The harnesses: at least one ──
# Each key offers its harness in New session; a harness with no key is not offered. A cloud
# session signs in to its provider with this key only, never a person's own login, and the
# sandbox gets only its own harness's key. Usage is billed to the key's account.

# Claude (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# Codex (platform.openai.com → API keys). Optional.
# OPENAI_API_KEY=


# ── OPTIONAL ─────────────────────────────────────────────────────────────────────────────────

# A GitHub token the sandbox clones the repository with, and pushes with when the agent pushes.
# Needed for a private repository, and for any push. A fine-grained token (GitHub → Settings →
# Developer settings → Personal access tokens) with "Contents: Read and write" on the repositories
# in CONSOLA_RUNNER_REPOSITORIES. It never appears in a URL, a command line or .git/config.
GIT_TOKEN=
