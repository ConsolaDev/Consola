#!/bin/sh
# consola-step-start: becomes an agent step's host in a step's sandbox (packages/host/AGENTS.md,
# "Step sandboxes"), after consola-step-checkout put the repository in /workspace/repo (or, for a
# step with no checkout, into an empty folder). The runner is the host's only client.
#
# A step reviews other people's pull requests: the checkout is the author's, and nothing in it may
# run or widen what the CLI does. What holds that:
#   - every turn's CLI runs `--restricted --strict-mcp-config --mcp-config <step tools> --allowedTools
#     <the four step tools>`, from the launch arguments of t3's Claude instance in the host's state
#     folder, $workspace/.consola/t3-state, which the runner wrote before this script runs
#     (core/steps/stepSandbox.ts, STEP_LAUNCH_ARGS);
#   - the thread opens with a title (--title), so t3 never runs `claude -p` in the checkout for one;
#   - the checkout's own .claude/settings.json and .claude/settings.local.json leave the working
#     tree here, for the one start t3 makes there without those flags: its workspace probe.
#
# Its variables are the runner's, for this command alone (stepHostEnv): CONSOLA_SESSION_ID,
# CONSOLA_HARNESS (claude), CONSOLA_PASS_PUBLIC_KEY, CONSOLA_SESSION_IDLE_MINUTES,
# CONSOLA_STEP_FOLDER and ANTHROPIC_API_KEY, which the host and its CLI hold and nothing else does.
# CONSOLA_WORKSPACE moves /workspace, for this script's tests (src/stepScripts.test.ts); the runner
# never sets it.
#
# Stdout belongs to the runner, which reads the host's JSON lines: the script prints nothing there.
set -eu

fail() {
  printf 'consola-step-start: %s\n' "$1" >&2
  exit 1
}

for name in CONSOLA_SESSION_ID CONSOLA_PASS_PUBLIC_KEY CONSOLA_STEP_FOLDER; do
  eval "value=\${$name-}"
  [ -n "$value" ] || fail "$name is not set."
done
[ "${CONSOLA_HARNESS:-claude}" = claude ] || fail 'A step runs on Claude alone.'

workspace="${CONSOLA_WORKSPACE:-/workspace}"
repo="$workspace/repo"
state="$workspace/.consola/t3-state"
key_file="$workspace/.consola/pass-public-key.pem"
[ -f "$state/userdata/settings.json" ] || fail "The step's t3 settings are not there."
mkdir -p "$repo" "$CONSOLA_STEP_FOLDER"

# The key the host checks every pass with (a public key): the runner's, made for this attempt.
key=$(printf '%s' "$CONSOLA_PASS_PUBLIC_KEY")
printf '%s\n' "$key" > "$key_file"

# The checkout's own Claude settings: never where t3's probe would load them.
rm -f -- "$repo/.claude/settings.json" "$repo/.claude/settings.local.json"

# A document the step reads (its pull request's changes) can be long: the CLI keeps all of a tool's
# answer up to this many tokens.
MAX_MCP_OUTPUT_TOKENS=200000
export MAX_MCP_OUTPUT_TOKENS

exec node /opt/consola/consola-host.mjs session \
  --session-id "$CONSOLA_SESSION_ID" \
  --harness claude \
  --cwd "$repo" \
  --bind 0.0.0.0 \
  --port 7420 \
  --pass-public-key "$key_file" \
  --idle-minutes "${CONSOLA_SESSION_IDLE_MINUTES:-10}" \
  --state-dir "$state" \
  --title 'Consola step'
