{
  "name": "consola-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=consola",
    "dev:website": "turbo run dev --filter=@consola/website",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e": "turbo run test:e2e --filter=consola",
    "start": "pnpm --filter consola start",
    "test:watch": "pnpm --filter consola test:watch",
    "build:icon": "pnpm --filter consola build:icon",
    "build:main": "pnpm --filter consola build:main",
    "build:preload": "pnpm --filter consola build:preload",
    "build:renderer": "pnpm --filter consola build:renderer",
    "package": "pnpm --filter consola package",
    "package:distribution": "pnpm --filter consola package:distribution",
    "release": "pnpm --filter consola release"
  },
  "devDependencies": {
    "turbo": "2.11.3"
  }
}
