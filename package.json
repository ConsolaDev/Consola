{
  "name": "consola",
  "productName": "Consola",
  "version": "1.0.0",
  "description": "Your command center for AI-assisted development. Built on top of Claude Code, Consola brings structure to AI coding through the RPI methodology (Research, Plan, Implement) with native integration to your issue trackers for seamless project management.",
  "main": "dist/main/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build --config vite.config.ts",
    "package": "npm run build && electron-builder --mac",
    "release": "npm run package && bash scripts/install-app.sh",
    "dev": "concurrently -k -n vite,main,preload,electron \"npm run dev:vite\" \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:electron\"",
    "dev:vite": "vite --config vite.config.ts",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "tsc -p tsconfig.preload.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://localhost:5173 && node scripts/dev-electron.cjs",
    "test:e2e": "playwright test",
    "postinstall": "npx @electron/rebuild -f -w node-pty"
  },
  "keywords": [
    "claude-code",
    "ai-development",
    "electron",
    "rpi-methodology",
    "linear",
    "issue-tracker"
  ],
  "author": "Javier Taraza",
  "license": "ISC",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "lodash-es": "^4.17.23",
    "lucide-react": "^0.563.0",
    "material-file-icons": "^2.4.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.5.9",
    "react-router-dom": "^7.13.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.19",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  }
}
