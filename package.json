{
  "name": "consola-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "postinstall": "node tools/link-worktree-env.mjs",
    "link-env": "node tools/link-worktree-env.mjs",
    "dev": "turbo run dev --filter=consola",
    "dev:website": "turbo run dev --filter=@consola/website",
    "dev:cloud": "turbo run dev --filter=@consola/cloud-api --filter=@consola/cloud-web",
    "build": "turbo run build --filter='!./vendor/**'",
    "test": "turbo run test --filter='!./vendor/**'",
    "test:vendor": "pnpm --filter './vendor/t3code/packages/*' --filter './vendor/t3code/apps/*' --filter '!...^t3' test",
    "typecheck": "turbo run typecheck --filter='!./vendor/**'",
    "typecheck:vendor": "pnpm --filter './vendor/t3code/packages/*' --filter './vendor/t3code/apps/*' typecheck",
    "lint": "biome check . && pnpm run lint:oxlint",
    "lint:oxlint": "turbo run build --filter='./packages/*' --filter='!@consola/agent-ui' --output-logs=errors-only && oxlint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:e2e": "turbo run test:e2e --filter=consola",
    "start": "pnpm --filter consola start",
    "test:watch": "pnpm --filter consola test:watch",
    "build:icon": "pnpm --filter consola build:icon",
    "build:main": "pnpm --filter consola build:main",
    "build:preload": "pnpm --filter consola build:preload",
    "build:renderer": "pnpm --filter consola build:renderer",
    "package": "pnpm --filter consola package",
    "package:distribution": "pnpm --filter consola package:distribution",
    "release": "pnpm --filter consola release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/oxlint-config": "0.2.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "turbo": "2.11.3"
  }
}
